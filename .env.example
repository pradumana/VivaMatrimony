# =============================================================================
# VIVA MATRIMONY APP — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=Viva
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_SECRET_KEY=CHANGE_ME_32_CHARS_MINIMUM_RANDOM_STRING
APP_HOST=0.0.0.0
APP_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Use the Supabase pooler URL for production (transaction pooler, port 6543)
# Special characters in password must be percent-encoded (e.g. # → %23)
DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:your_db_password@aws-0-region.pooler.supabase.com:6543/postgres

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_DIFFERENT_FROM_APP_SECRET_64_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# -----------------------------------------------------------------------------
# OTP
# -----------------------------------------------------------------------------
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SEND_PER_DAY=10

# -----------------------------------------------------------------------------
# WhatsApp Provider
# Set WHATSAPP_PROVIDER to: openwa | official | mock (for tests)
# -----------------------------------------------------------------------------
WHATSAPP_PROVIDER=openwa

# OpenWA (development)
OPENWA_BASE_URL=http://localhost:8002
OPENWA_API_KEY=your_openwa_session_key_here

# Official Meta WhatsApp Business Cloud API (production)
META_WHATSAPP_TOKEN=your_meta_whatsapp_token_here
META_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
META_WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here

# -----------------------------------------------------------------------------
# Supabase Storage Buckets
# -----------------------------------------------------------------------------
STORAGE_BUCKET_PROFILE_PHOTOS=profile-photos
STORAGE_BUCKET_BIODATA=biodata-pdfs
STORAGE_BUCKET_VERIFICATION_DOCS=verification-docs   # private bucket

# File limits
MAX_PHOTO_SIZE_MB=10
MAX_DOCUMENT_SIZE_MB=20
THUMBNAIL_WIDTH=400
THUMBNAIL_HEIGHT=500

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_OTP_PER_HOUR=5
RATE_LIMIT_SEARCH_PER_MINUTE=30

# -----------------------------------------------------------------------------
# Admin
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@viva.app
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_BEFORE_PRODUCTION

# -----------------------------------------------------------------------------
# PDF Generation (WeasyPrint / reportlab)
# -----------------------------------------------------------------------------
PDF_FONT_DIR=app/utils/fonts
PDF_TEMPLATE_DIR=app/utils/templates

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# CORS / Security
# -----------------------------------------------------------------------------
BCRYPT_ROUNDS=12
SECURE_COOKIES=false   # Set true in production with HTTPS

# -----------------------------------------------------------------------------
# Notifications (FCM for push)
# -----------------------------------------------------------------------------
FCM_SERVER_KEY=your_firebase_cloud_messaging_server_key_here
