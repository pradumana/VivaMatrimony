# =============================================================================
# VIVA MATRIMONY APP — ENVIRONMENT VARIABLES
# Copy this file to backend/.env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=Viva
APP_ENV=production           # development | staging | production
APP_DEBUG=false              # MUST be false in production
APP_SECRET_KEY=CHANGE_ME_32_CHARS_MINIMUM_RANDOM_STRING
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS — add every origin that needs to call the API from a browser.
# The Flutter mobile app does NOT need to be listed (native HTTP bypasses CORS).
# Include your admin panel's production URL here.
ALLOWED_ORIGINS=http://localhost:5173,https://your-admin-panel-domain.com

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Database — use the Supabase transaction pooler URL for production (port 6543).
# Special characters in password must be percent-encoded (e.g. # → %23)
DATABASE_URL=postgresql://postgres.your-project-ref:your_db_password@aws-0-region.pooler.supabase.com:6543/postgres

# Supabase Auth JWT Secret
# Found in: Supabase Dashboard → Project Settings → API → JWT Secret
# Used by the backend to verify Supabase-issued access tokens.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# -----------------------------------------------------------------------------
# Admin JWT (for viva-admin panel login — separate from Supabase user tokens)
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_DIFFERENT_FROM_APP_SECRET_64_CHARS_MINIMUM
JWT_ALGORITHM=HS256

# -----------------------------------------------------------------------------
# Supabase Storage Buckets
# -----------------------------------------------------------------------------
STORAGE_BUCKET_PROFILE_PHOTOS=profile-photos
STORAGE_BUCKET_BIODATA=biodata-pdfs
STORAGE_BUCKET_VERIFICATION_DOCS=verification-docs   # private bucket

# File limits
MAX_PHOTO_SIZE_MB=10
MAX_DOCUMENT_SIZE_MB=20
THUMBNAIL_WIDTH=400
THUMBNAIL_HEIGHT=500

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_SEARCH_PER_MINUTE=30

# -----------------------------------------------------------------------------
# Admin
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@viva.app
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD

# -----------------------------------------------------------------------------
# PDF Generation
# -----------------------------------------------------------------------------
PDF_FONT_DIR=app/utils/fonts
PDF_TEMPLATE_DIR=app/utils/templates

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
BCRYPT_ROUNDS=12
SECURE_COOKIES=true          # set true in production

# -----------------------------------------------------------------------------
# Notifications (FCM) — optional, leave blank if not configured
# -----------------------------------------------------------------------------
FCM_SERVER_KEY=
